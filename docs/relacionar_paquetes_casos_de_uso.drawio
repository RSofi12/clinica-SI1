        <mxCell id="dep_p1_p2" style="html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=open;dashed=1;dashPattern=5 5;exitX=0;exitY=0.7;entryX=0.5;entryY=0;" edge="1" source="vp_p1" target="vp_p2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lbl_p1_p2" value="&amp;laquo;access&amp;raquo;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#475569;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="dep_p1_p2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-10" y="-10" as="offset" /></mxGeometry></mxCell>

        <mxCell id="dep_p1_p3" style="html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=open;dashed=1;dashPattern=5 5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="vp_p1" target="vp_p3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lbl_p1_p3" value="&amp;laquo;access&amp;raquo;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#475569;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="dep_p1_p3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell>

        <mxCell id="dep_p1_p4" style="html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=open;dashed=1;dashPattern=5 5;exitX=1;exitY=0.7;entryX=0.5;entryY=0;" edge="1" source="vp_p1" target="vp_p4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lbl_p1_p4" value="&amp;laquo;access&amp;raquo;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#475569;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="dep_p1_p4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="10" y="-10" as="offset" /></mxGeometry></mxCell>

        <!-- P3 depende de P2 (provisión de médicos, pacientes, horarios) -->
        <mxCell id="dep_p3_p2" style="html=1;strokeColor=#0284C7;strokeWidth=1.5;endArrow=open;dashed=1;dashPattern=5 5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="vp_p3" target="vp_p2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lbl_p3_p2" value="&amp;laquo;import&amp;raquo;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#0284C7;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="dep_p3_p2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell>

        <!-- P4 depende de P3 (cita atendida origina consulta médica) -->
        <mxCell id="dep_p4_p3" style="html=1;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=open;dashed=1;dashPattern=5 5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="vp_p4" target="vp_p3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lbl_p4_p3" value="&amp;laquo;import&amp;raquo;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#7C3AED;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="dep_p4_p3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell>

        <!-- P5 depende de P3 (eventos de cita disparan pagos y recordatorios) -->
        <mxCell id="dep_p5_p3" style="html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=open;dashed=1;dashPattern=5 5;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" source="vp_p5" target="vp_p3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lbl_p5_p3" value="&amp;laquo;use&amp;raquo;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#DC2626;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="dep_p5_p3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-15" y="0" as="offset" /></mxGeometry></mxCell>

        <!-- P6 depende de P2, P3 y P4 (consultas agregadas de solo lectura) -->
        <mxCell id="dep_p6_p3" style="html=1;strokeColor=#D97706;strokeWidth=1.5;endArrow=open;dashed=1;dashPattern=5 5;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" edge="1" source="vp_p6" target="vp_p3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lbl_p6_p3" value="&amp;laquo;use&amp;raquo;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontFamily=Helvetica;fontColor=#D97706;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="dep_p6_p3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="15" y="0" as="offset" /></mxGeometry></mxCell>

