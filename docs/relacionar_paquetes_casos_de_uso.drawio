        <mxCell id="tr_p6_23" style="html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;dashed=1;dashPattern=5 5;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" source="pkg_p6" target="p6_cu23" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
