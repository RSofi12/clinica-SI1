  <!-- ========================================================================= -->
  <!-- PÁGINA 7: 3.1.3 VISTA DE PAQUETES (DIAGRAMA DE ARQUITECTURA DE PAQUETES) -->
  <!-- ========================================================================= -->
  <diagram id="diag_vista_paquetes" name="3.1.3 - Vista de Paquetes">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TÍTULO -->
        <mxCell id="t_vpkg" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;3.1.3. VISTA DE PAQUETES — ARQUITECTURA DE DOMINIO PUDS&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 12px; color: #475569;&quot;&gt;Organización y dependencias entre los 6 Paquetes de Dominio de la Clínica La Cruz&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- PAQUETE 1: SEGURIDAD Y AUDITORÍA (TRANSVERSAL ARRIBA) -->
        <mxCell id="vp_p1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;P1: Seguridad y Auditoría&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;/&gt;&lt;span style=&quot;font-size: 10px; color: #334155;&quot;&gt;+ CU01: Autenticar usuario&lt;br/&gt;+ CU02: Gestionar usuarios y roles&lt;br/&gt;+ CU03: Gestionar bitácora auditoría&lt;/span&gt;" style="shape=folder;tabWidth=110;tabHeight=24;tabPosition=left;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- PAQUETE 2: RECURSOS CLÍNICOS Y PACIENTES -->
        <mxCell id="vp_p2" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;P2: Recursos Clínicos y Pacientes&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;/&gt;&lt;span style=&quot;font-size: 10px; color: #334155;&quot;&gt;+ CU04: Gestionar pacientes&lt;br/&gt;+ CU05: Gestionar cuenta/perfil&lt;br/&gt;+ CU06: Gestionar médicos&lt;br/&gt;+ CU07: Gestionar especialidades&lt;br/&gt;+ CU08: Gestionar horarios médicos&lt;/span&gt;" style="shape=folder;tabWidth=130;tabHeight=24;tabPosition=left;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="270" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- PAQUETE 3: GESTIÓN DE CITAS MÉDICAS (NÚCLEO CENTRAL) -->
        <mxCell id="vp_p3" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;P3: Gestión de Citas Médicas&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;/&gt;&lt;span style=&quot;font-size: 10px; color: #334155;&quot;&gt;+ CU09: Consultar disponibilidad&lt;br/&gt;+ CU10: Programar cita médica&lt;br/&gt;+ CU11: Reprogramar cita médica&lt;br/&gt;+ CU12: Cancelar cita médica&lt;br/&gt;+ CU13: Registrar asistencia&lt;br/&gt;+ CU14: Agenda médica diaria&lt;br/&gt;+ CU15: Historial de citas&lt;/span&gt;" style="shape=folder;tabWidth=120;tabHeight=24;tabPosition=left;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="480" y="270" width="260" height="160" as="geometry" />
        </mxCell>

        <!-- PAQUETE 4: HISTORIAL CLÍNICO Y CONSULTAS -->
        <mxCell id="vp_p4" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;P4: Historial Clínico y Consultas&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;/&gt;&lt;span style=&quot;font-size: 10px; color: #334155;&quot;&gt;+ CU16: Registrar consulta médica&lt;br/&gt;+ CU17: Gestionar antecedentes&lt;br/&gt;+ CU18: Expediente digital y recetas&lt;br/&gt;+ CU19: Consultar expediente médico&lt;/span&gt;" style="shape=folder;tabWidth=130;tabHeight=24;tabPosition=left;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="860" y="270" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- PAQUETE 5: INTEGRACIONES Y PAGOS -->
        <mxCell id="vp_p5" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;P5: Integraciones y Pagos&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;/&gt;&lt;span style=&quot;font-size: 10px; color: #334155;&quot;&gt;+ CU20: Recordatorios y notif. push&lt;br/&gt;+ CU21: Pago con Stripe Sandbox&lt;/span&gt;" style="shape=folder;tabWidth=110;tabHeight=24;tabPosition=left;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="300" y="540" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- PAQUETE 6: REPORTES Y ANALÍTICA -->
        <mxCell id="vp_p6" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;P6: Reportes y Analítica&lt;/b&gt;&lt;hr style=&quot;margin: 4px 0;&quot;/&gt;&lt;span style=&quot;font-size: 10px; color: #334155;&quot;&gt;+ CU22: Reportes filtros dinámicos RF13&lt;br/&gt;+ CU23: Reporte por voz con IA&lt;/span&gt;" style="shape=folder;tabWidth=110;tabHeight=24;tabPosition=left;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="680" y="540" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- DEPENDENCIAS ENTRE PAQUETES (FLECHAS DASHED UML) -->
