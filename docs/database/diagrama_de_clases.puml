@startuml DiagramaClases_ClinicaPrivada_Metodos
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 3
skinparam class {
  BackgroundColor<<seg>>   #DAE8FC
  BackgroundColor<<mae>>   #D5E8D4
  BackgroundColor<<pac>>   #FFF2CC
  BackgroundColor<<cit>>   #FFE6CC
  BackgroundColor<<cli>>   #E1D5E7
  BackgroundColor<<ext>>   #F8CECC
  BorderColor #555555
  FontName Helvetica
  FontSize 11
}
hide circle
hide stereotype

' =============================================================================
' 1. SEGURIDAD Y AUDITORÍA (AZUL PASTEL - #DAE8FC)
' =============================================================================
class Usuario <<seg>> {
  + id_usuario: Long [PK]
  + username: String [UNIQUE]
  + email: String [UNIQUE]
  + password_hash: String
  + tipo_usuario: String
  + estado: String
  + intentos_fallidos: Int
  + bloqueado_hasta: DateTime
  + ultimo_acceso: DateTime
  + fecha_creacion: DateTime
  + fecha_actualizacion: DateTime
  --
  + autenticar(password: String): Boolean
  + estaBloqueadoTemporalmente(): Boolean
  + recuperarPassword(token: String): Boolean
  + bloquearAcceso(): Void
  + actualizarUltimoAcceso(): Void
}

class Rol <<seg>> {
  + id_rol: Long [PK]
  + nombre: String [UNIQUE]
  --
  + asignarPermiso(id_p: Long): Void
}

class Permiso <<seg>> {
  + id_permiso: Long [PK]
  + nombre: String [UNIQUE]
  --
  + verificarPermiso(cod: String): Boolean
}

class UsuarioRol as "UsuarioRol\n<size:9><b>«Clase Asociación»</b></size>" <<seg>> {
  + id_usuario: Long [PK, FK]
  + id_rol: Long [PK, FK]
}

class RolPermiso as "RolPermiso\n<size:9><b>«Clase Asociación»</b></size>" <<seg>> {
  + id_rol: Long [PK, FK]
  + id_permiso: Long [PK, FK]
}

class TokenRecuperacion <<seg>> {
  + id_token: Long [PK]
  + id_usuario: Long [FK]
  + token_hash: String
  + tipo_token: String
  + fecha_creacion: DateTime
  + fecha_expiracion: DateTime
  + usado: Boolean
  --
  + validarToken(token: String): Boolean
  + marcarComoUsado(): Void
}

' Nueva clase para configurar intentos y minutos de bloqueo temporal (CU01 / Seguridad)
class ConfiguracionSeguridad <<seg>> {
  + id_configuracion: Int [PK]
  + max_intentos_fallidos: Int
  + minutos_bloqueo: Int
  + actualizado_por: Long [FK]
  + fecha_actualizacion: DateTime
  --
  + obtenerPoliticaActiva(): ConfiguracionSeguridad
  + actualizarPolitica(maxIntentos: Int, minutos: Int): Void
}

class Bitacora <<seg>> {
  + id_bitacora: Long [PK]
  + id_usuario: Long [FK]
  + modulo: String
  + accion: String
  + tabla_afectada: String
  + id_registro: Long
  + descripcion: Text
  + ip_origen: String
  + fecha_registro: DateTime
  --
  + registrarEvento(u: Long, acc: String): Void
  + filtrarPorModulo(mod: String): List
}

' =============================================================================
' 2. DATOS MAESTROS Y RECURSOS CLÍNICOS (VERDE PASTEL - #D5E8D4)
' =============================================================================
class Especialidad <<mae>> {
  + id_especialidad: Long [PK]
  + nombre: String
  + nombre_normalizado: String [UNIQUE]
  + descripcion: Text [0..1]
  + edad_min_anios: Int [0..1]
  + edad_max_anios: Int [0..1]
  + precio_consulta: Decimal
  + estado: String
  --
  + validarRangoEdad(edad: Int): Boolean
  + cambiarEstado(est: String): Void
}

class Medico <<mae>> {
  + id_medico: Long [PK]
  + id_usuario: Long [FK, UNIQUE]
  + codigo_profesional: String [UNIQUE]
  + nombres: String
  + apellidos: String
  + telefono_contacto: String
  + correo_profesional: String
  + estado_activo: Boolean
  --
  + asignarEspecialidad(id_esp: Long): Void
  + obtenerAgenda(fecha: Date): List
  + cambiarEstado(activo: Boolean): Void
}

class MedicoEspecialidad as "MedicoEspecialidad\n<size:9><b>«Clase Asociación»</b></size>" <<mae>> {
  + id_medico: Long [PK, FK]
  + id_especialidad: Long [PK, FK]
  + es_principal: Boolean
}

class Disponibilidad <<mae>> {
  + id_disponibilidad: Long [PK]
  + id_medico: Long [FK]
  + dia_semana: Int (1-7)
  + hora_inicio: Time
  + hora_fin: Time
  + duracion_cita_minutos: Int
  + activo: Boolean
  --
  + generarSlots(fecha: Date): List
  + verificarHorario(hora: Time): Boolean
}

class BloqueoHorario <<mae>> {
  + id_bloqueo: Long [PK]
  + id_medico: Long [FK] [0..1]
  + fecha: Date
  + hora_inicio: Time [0..1]
  + hora_fin: Time [0..1]
  + motivo: String
  --
  + esFeriadoGeneral(): Boolean
  + solapaConHorario(h: Time): Boolean
}

' =============================================================================
' 3. PACIENTES (AMARILLO PASTEL - #FFF2CC)
' =============================================================================
class Paciente <<pac>> {
  + id_paciente: Long [PK]
  + id_usuario: Long [FK, UNIQUE, 0..1]
  + numero_historia: String [UNIQUE]
  + numero_documento: String [UNIQUE]
  + nombres: String
  + apellidos: String
  + fecha_nacimiento: Date
  + sexo: String
  + tipo_sangre: String [0..1]
  + telefono: String
  + correo: String [0..1]
  + direccion: Text [0..1]
  + notificaciones_activas: Boolean
  + estado_paciente: String
  + fecha_registro: DateTime
  --
  + calcularEdad(): Int
  + vincularUsuario(id_u: Long): Void
  + actualizarContacto(): Void
}

class ContactoEmergencia <<pac>> {
  + id_contacto: Long [PK]
  + id_paciente: Long [FK]
  + nombre: String
  + parentesco: String
  + telefono: String
  --
  + actualizarTelefono(tel: String): Void
}

' =============================================================================
' 4. GESTIÓN DE CITAS MÉDICAS (NARANJA PASTEL - #FFE6CC)
' =============================================================================
class TipoCita <<cit>> {
  + id_tipo_cita: Long [PK]
  + nombre: String [UNIQUE]
  --
  + obtenerNombre(): String
}

class Cita <<cit>> {
  + id_cita: Long [PK]
  + codigo_cita: String [UNIQUE]
  + id_paciente: Long [FK]
  + id_medico: Long [FK]
  + id_especialidad: Long [FK]
  + id_tipo_cita: Long [FK]
  + id_cita_origen: Long [FK, 0..1]
  + fecha_hora_inicio: DateTime
  + fecha_hora_fin: DateTime
  + motivo_breve: String [0..1]
  + modalidad: String
  + estado: String
  + motivo_cancelacion: String [0..1]
  + cancelada_en: DateTime [0..1]
  + creada_por: Long [FK]
  + fecha_creacion: DateTime
  + fecha_actualizacion: DateTime
  --
  + programar(id_p, id_m, f, h): Cita
  + reprogramar(nf, nh): Boolean
  + cancelar(motivo: String): Boolean
  + cambiarEstado(est: String): Void
  + validarSolapamiento(): Boolean
}

class CitaEstadoHistorial <<cit>> {
  + id_cambio: Long [PK]
  + id_cita: Long [FK]
  + estado_anterior: String
  + estado_nuevo: String
  + id_usuario: Long [FK]
  + observacion: String [0..1]
  + fecha_cambio: DateTime
  --
  + registrarCambio(ant, nuev): Void
}

' =============================================================================
' 5. HISTORIAL CLÍNICO Y CONSULTAS (MORADO PASTEL - #E1D5E7)
' =============================================================================
class HistoriaClinica <<cli>> {
  + id_historia_clinica: Long [PK]
  + id_paciente: Long [FK, UNIQUE]
  + fecha_apertura: Date
  + estado: String
  --
  + aperturar(id_pac: Long): Void
  + archivar(motivo: String): Void
}

class ConsultaMedica <<cli>> {
  + id_consulta: Long [PK]
  + id_cita: Long [FK, UNIQUE]
  + id_historia_clinica: Long [FK]
  + id_medico: Long [FK]
  + motivo_consulta: Text
  + peso_kg: Decimal [0..1]
  + talla_cm: Decimal [0..1]
  + temperatura_c: Decimal [0..1]
  + presion_arterial: String [0..1]
  + frecuencia_cardiaca: Int [0..1]
  + observaciones: Text [0..1]
  + plan_tratamiento: Text
  + fecha_consulta: DateTime
  --
  + registrarTriaje(p, t, pa): Void
  + emitirDiagnostico(cie, pl): Void
  + finalizarConsulta(): Void
}

class Antecedente <<cli>> {
  + id_antecedente: Long [PK]
  + id_historia_clinica: Long [FK]
  + tipo_antecedente: String
  + descripcion: Text
  + registrado_por: Long [FK]
  + fecha_registro: DateTime
  + estado: String
  --
  + clasificarPorTipo(t: String): Void
}

class Diagnostico <<cli>> {
  + id_diagnostico: Long [PK]
  + id_historia_clinica: Long [FK]
  + id_consulta: Long [FK]
  + descripcion: Text
  + codigo_cie10: String [0..1]
  + tipo: String
  + fecha_registro: DateTime
  --
  + asignarCIE10(cod: String): Void
  + cambiarATipoDefinitivo(): Void
}

class Evolucion <<cli>> {
  + id_evolucion: Long [PK]
  + id_historia_clinica: Long [FK]
  + id_medico: Long [FK]
  + nota: Text
  + fecha_registro: DateTime
  --
  + agregarNota(n: Text): Void
}

class Receta <<cli>> {
  + id_receta: Long [PK]
  + id_historia_clinica: Long [FK]
  + id_consulta: Long [FK]
  + id_medico: Long [FK]
  + indicaciones_generales: Text [0..1]
  + fecha_emision: DateTime
  + estado: String
  --
  + agregarDetalle(d: Detalle): Void
  + anularReceta(): Void
}

class RecetaDetalle <<cli>> {
  + id_detalle: Long [PK]
  + id_receta: Long [FK]
  + medicamento: String
  + dosis: String
  + frecuencia: String
  + duracion: String
  + indicaciones: Text [0..1]
  --
  + validarPosologia(): Boolean
}

class AnalisisClinico <<cli>> {
  + id_analisis: Long [PK]
  + id_historia_clinica: Long [FK]
  + id_medico: Long [FK]
  + resumen: Text
  + alertas: JSON
  + modelo_ia: String
  + fecha_generacion: DateTime
  --
  + generarResumenIA(h: Text): Void
  + detectarAlertas(): JSON
}

class OrdenExamen <<cli>> {
  + id_orden: Long [PK]
  + codigo_orden: String [UNIQUE]
  + id_consulta: Long [FK]
  + id_historia_clinica: Long [FK]
  + id_medico: Long [FK]
  + tipo_estudio: String
  + nombre_estudio: String
  + indicaciones_preparacion: Text [0..1]
  + diagnostico_presuntivo: String [0..1]
  + estado: String
  + fecha_emision: DateTime
  --
  + emitirOrden(tipo: String, nombre: String): OrdenesExamenes
  + actualizarEstado(est: String): Void
}

class DocumentoClinico <<cli>> {
  + id_documento: Long [PK]
  + id_historia_clinica: Long [FK]
  + id_consulta: Long [FK, 0..1]
  + id_orden: Long [FK, 0..1]
  + id_medico: Long [FK]
  + titulo: String
  + tipo_documento: String
  + descripcion: Text [0..1]
  + ruta_archivo: String
  + mime_type: String
  + tamanio_bytes: Long
  + fecha_subida: DateTime
  + estado: String
  --
  + subirArchivo(ruta: String, tipo: String): DocumentosClinicos
  + archivar(): Void
}

' =============================================================================
' 6. PAGOS, NOTIFICACIONES Y REPORTES IA (ROSA PASTEL - #F8CECC)
' =============================================================================
class Pago <<ext>> {
  + id_pago: Long [PK]
  + id_cita: Long [FK]
  + id_paciente: Long [FK]
  + monto: Decimal
  + moneda: String
  + estado: String
  + stripe_payment_intent_id: String [UNIQUE]
  + fecha_pago: DateTime
  --
  + procesarStripe(token: String): Boolean
  + confirmarPago(): Void
}

class Notificacion <<ext>> {
  + id_notificacion: Long [PK]
  + id_usuario: Long [FK]
  + id_cita: Long [FK] [0..1]
  + tipo: String
  + titulo: String
  + mensaje: Text
  + estado: String
  + fecha_programada: DateTime
  + fecha_envio: DateTime [0..1]
  --
  + enviarRecordatorio(): Boolean
  + programarAviso(f: DateTime): Void
}

class PushSuscripcion <<ext>> {
  + id_suscripcion: Long [PK]
  + id_usuario: Long [FK]
  + endpoint: Text
  + clave_p256dh: String
  + clave_auth: String
  + activa: Boolean
  --
  + activarSuscripcion(): Void
}

class ReporteIA <<ext>> {
  + id_reporte: Long [PK]
  + id_usuario: Long [FK]
  + comando_texto: Text
  + filtros_json: JSON
  + tipo_reporte: String
  + fecha_generacion: DateTime
  --
  + procesarComandoVoz(aud: Text): Void
  + ejecutarFiltros(f: JSON): List
}

' =============================================================================
' RELACIONES UML RIGUROSAS (ASOCIACIONES, COMPOSICIONES REALES Y CLASES ASOCIACIÓN)
' =============================================================================

' --- 1. SEGURIDAD Y AUDITORÍA ---
Usuario "1" *-- "0..*" TokenRecuperacion : posee (ON DELETE CASCADE)
Usuario "1" -- "0..*" Bitacora : genera
Usuario "0..1" -- "0..*" ConfiguracionSeguridad : actualiza
Usuario "1" -- "0..1" Medico : vinculado a
Usuario "1" -- "0..1" Paciente : cuenta web de

' Tablas Intermedias / Clases Asociación N:M puras
Usuario "1" -- "0..*" UsuarioRol : posee
Rol "1" -- "0..*" UsuarioRol : asigna
Rol "1" -- "0..*" RolPermiso : tiene
Permiso "1" -- "0..*" RolPermiso : otorga

' --- 2. RECURSOS CLÍNICOS Y PACIENTES ---
' Composición Real: Contacto de emergencia no tiene sentido de existencia sin su Paciente
Paciente "1" *-- "0..*" ContactoEmergencia : compone

' Clase Asociación N:M con atributo propio ('es_principal')
Medico "1" -- "1..*" MedicoEspecialidad : ejerce
Especialidad "1" -- "0..*" MedicoEspecialidad : agrupa

' Asociaciones 1:N
Medico "1" *-- "0..*" Disponibilidad : define (ON DELETE CASCADE)
Medico "0..1" *-- "0..*" BloqueoHorario : aplica (ON DELETE CASCADE)

' --- 3. GESTIÓN DE CITAS MÉDICAS ---
Paciente "1" -- "0..*" Cita : reserva
Medico "1" -- "0..*" Cita : atiende
Especialidad "1" -- "0..*" Cita : pertenece a
TipoCita "1" -- "0..*" Cita : clasifica
Cita "0..1" -- "0..1" Cita : reprograma origen/destino

' Composición Real: El historial de cambios de estado depende exclusivamente de la Cita
Cita "1" *-- "0..*" CitaEstadoHistorial : audita estados de

' --- 4. HISTORIAL CLÍNICO Y CONSULTAS ---
Paciente "1" -- "1" HistoriaClinica : posee
Cita "1" -- "0..1" ConsultaMedica : origina
HistoriaClinica "1" -- "0..*" ConsultaMedica : registra
ConsultaMedica "1" *-- "0..*" Diagnostico : evalÃºa
ConsultaMedica "1" -- "0..*" Receta : prescribe
ConsultaMedica "1" -- "0..*" OrdenExamen : prescribe
HistoriaClinica "1" -- "0..*" DocumentoClinico : custodia
OrdenExamen "0..1" -- "0..*" DocumentoClinico : respalda

' Composiciones Reales (Dependencia ontológica y de ciclo de vida)
HistoriaClinica "1" *-- "0..*" Antecedente : compone
HistoriaClinica "1" *-- "0..*" Evolucion : compone
HistoriaClinica "1" *-- "0..*" AnalisisClinico : genera
Receta "1" *-- "1..*" RecetaDetalle : compone (ON DELETE CASCADE)

' --- 5. INTEGRACIONES, PAGOS Y REPORTES ---
Cita "1" -- "0..1" Pago : se paga con
Paciente "1" -- "0..*" Pago : realiza
Usuario "1" *-- "0..*" Notificacion : recibe (ON DELETE CASCADE)
Usuario "1" *-- "0..*" PushSuscripcion : suscribe (ON DELETE CASCADE)
Usuario "1" -- "0..*" ReporteIA : solicita por voz
@enduml
